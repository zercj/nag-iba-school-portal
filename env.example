NODE_ENV=development
PORT=8000
APP_ORIGIN=http://localhost:8000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL=false
BOOTSTRAP_DEVELOPERS=[]
# Supabase Storage holds every uploaded file (lesson plans, memos, photos, attachments).
# Required in production. Use the project URL and a SECRET key (Project Settings > API Keys).
# Never put the secret key in browser code or commit it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=
# Optional: bucket name (default portal-files; created automatically as a private bucket).
# SUPABASE_BUCKET=portal-files
# Optional: set to false to skip moving old database-stored files to Storage on start.
# MIGRATE_LEGACY_FILES=true
